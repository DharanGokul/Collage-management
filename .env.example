# Copy to .env.local and adjust. Every variable is optional; the defaults suit the demo build.
# Only VITE_-prefixed variables are exposed to the browser: never put a secret in this file.

# Platform domain: colleges get <slug>.<this> until they connect their own domain.
VITE_PLATFORM_DOMAIN=campusone.app

# Platform operator sign-in (the super admin console).
VITE_SUPER_ADMIN_EMAIL=super@campusone.app

# Demo auth: pre-provisions every person with the password Demo@1234 and shows a "Demo inbox"
# with the codes and links that would be emailed. Set to false to require invite/activation links.
VITE_AUTH_DEMO=true

# Custom-domain verification: "simulate" (any valid domain passes) or "doh" (checks real DNS records
# through a public DNS-over-HTTPS resolver; the backend must do this in production).
VITE_DNS_VERIFY=simulate

# Edge address(es) a root domain (tnkportal.com) must point its A record to. Comma-separated.
VITE_PLATFORM_IPS=203.0.113.10
